# Copy to .env and adjust. NEVER commit real secrets.

ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection (production). Tests use in-memory SQLite automatically.
DATABASE_URL=postgresql+psycopg2://erp:erp@db:5432/erp

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value

ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
FISCAL_YEAR_START_MONTH=4

# Initial superuser created by the seed step.
ERP_ADMIN_USERNAME=admin
ERP_ADMIN_PASSWORD=change-this-admin-password
ERP_ADMIN_EMAIL=admin@demo.local

# Observability
LOG_LEVEL=INFO
# LOG_JSON=true    # one JSON object per log line, for a log shipper

# --- E-invoice (IRN via a GST Suvidha Provider) ---
# Default is the offline simulator. To go live, set EINVOICE_GSP=gsp and fill in
# your GSP's REST endpoint and the GSTIN's e-invoice API credentials. These are
# SECRETS — keep them in .env / your secrets manager, never in git.
EINVOICE_GSP=simulator
# EINVOICE_GSP=gsp
# EINVOICE_BASE_URL=https://api.your-gsp.example/einvoice
# EINVOICE_AUTH_PATH=/auth
# EINVOICE_IRN_PATH=/invoice
# EINVOICE_CANCEL_PATH=/invoice/cancel
# EINVOICE_CLIENT_ID=
# EINVOICE_CLIENT_SECRET=
# EINVOICE_USERNAME=
# EINVOICE_PASSWORD=
# EINVOICE_GSTIN=03ABCDE1234F1Z5
# Most GSPs (Webtel, Pinnacle, MasterGST, TaxPro) want an API subscription key
# on every call; the header name is GSP-specific (ask your GSP).
# EINVOICE_SUBSCRIPTION_KEY=
# EINVOICE_SUBSCRIPTION_HEADER=subscription-key
# EINVOICE_TIMEOUT_SECONDS=20
# E-way bill shares the GSP connection above; only the endpoints differ.
# EWB_PATH=/ewaybill
# EWB_CANCEL_PATH=/ewaybill/cancel
# EWB_THRESHOLD=50000
